# Copy to .env (make setup does this). Every value has a working local default;
# only fill in what you want to turn on.

# --- LLM gateway ---------------------------------------------------------------
# Without a key the gateway runs "offline": pipelines work, extractions are empty.
ANTHROPIC_API_KEY=
# Optional providers routed through LiteLLM (compose/litellm/config.yaml)
OPENAI_API_KEY=
VOYAGE_API_KEY=
# Per-task routing overrides, e.g. GATEWAY_ROUTE_EXTRACT_INTERACTION=litellm:gpt-default
# GATEWAY_EMBED_DEFAULT=litellm:embed-default
# Langfuse (make up-full) - keys match the ones compose provisions
# LANGFUSE_HOST=http://localhost:13100
# LANGFUSE_PUBLIC_KEY=pk-lf-local
# LANGFUSE_SECRET_KEY=sk-lf-local

# --- Connectors (OAuth apps in test mode, see docs/connectors.md) --------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# --- Slack app (docs/slack.md) ------------------------------------------------
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# --- SSO (optional; dev login is on by default locally) ------------------------
WORKOS_API_KEY=
WORKOS_CLIENT_ID=

# --- Secrets: the defaults are for local development only ----------------------
# SESSION_SECRET=
# INTERNAL_SERVICE_TOKEN=
# LOCAL_MASTER_KEY=   # base64 of 32 random bytes: openssl rand -base64 32
